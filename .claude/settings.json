{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",

  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "timeout": 30,
            "command": "${CLAUDE_PROJECT_DIR}/.venv/Scripts/python.exe",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/format_on_edit.py"]
          }
        ]
      }
    ]
  },

  "permissions": {
    "allow": [
      "Bash(.venv/Scripts/python.exe -m ruff check *)",
      "Bash(.venv/Scripts/python.exe -m ruff format *)",
      "Bash(.venv/Scripts/python.exe -m pyright *)",
      "Bash(.venv/Scripts/python.exe -m pytest *)",
      "Bash(.venv/Scripts/python.exe -m pre_commit run *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "PowerShell(.venv\\Scripts\\python.exe -m ruff check *)",
      "PowerShell(.venv\\Scripts\\python.exe -m ruff format *)",
      "PowerShell(.venv\\Scripts\\python.exe -m pyright *)",
      "PowerShell(.venv\\Scripts\\python.exe -m pytest *)",
      "PowerShell(.venv\\Scripts\\python.exe -m pre_commit run *)",
      "PowerShell(git status *)",
      "PowerShell(git diff *)",
      "PowerShell(git log *)"
    ],
    "ask": [
      "Edit(/ruff.toml)",
      "Write(/ruff.toml)"
    ]
  }
}
